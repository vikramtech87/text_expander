export global Palette {
    // macOS-friendly adaptive light palette
    in-out property <color> window-bg: #f6f6f6;
    in-out property <color> text-primary: #1e1e1e;
    in-out property <color> text-secondary: #6e6e73;
    in-out property <color> text-error: #ff3333;

    // Selection styles (inspired by macOS accent colors)
    in-out property <color> selection-bg: #007aff;
    in-out property <color> selection-text: #ffffff;
    in-out property <color> selection-hover: #e3e3e3;
}

export global LayoutSize {
    in-out property <length> padding: 16px;
    in-out property <length> spacing: 8px;
    in-out property <length> border-radius: 6px;
}